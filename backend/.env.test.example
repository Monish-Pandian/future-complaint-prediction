# ====================================================
# Dedicated Test Environment Configuration (Example)
# ====================================================
NODE_ENV=test
PORT=5001

# Isolated Test Database
MONGO_URI=mongodb://127.0.0.1:27017/civic_forecasting_test

# JWT Security Secrets for Testing
JWT_SECRET=super_secret_jwt_key_civic_forecasting_test_2026_secure
JWT_EXPIRES_IN=1h

# Client Application URL
CLIENT_URL=http://localhost:5173

# AI Prediction Service Test Configuration
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_API_KEY=test_ai_key_mock_secret
AI_SERVICE_TIMEOUT=5000
AI_SERVICE_ENABLED=false
AI_SERVICE_MOCK=true
AI_MODEL_VERSION=test-mock-v1
